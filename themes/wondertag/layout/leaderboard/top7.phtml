<?php
/**
 * Top 7 Leaderboard View
 *
 * Rendered inside leaderboard/content.phtml. Expects the page controller
 * (leaderboard.php, Dev 6) to have populated $wo['top7_rankings'] the
 * same way timeline.php populates $wo['user_posts'] — server-rendered
 * on initial load, not fetched client-side.
 *
 * Row shape (matches Dev 2's JSON contract):
 *   ['rank' => 1, 'username' => 'string', 'name' => 'string',
 *    'avatar' => 'upload/photos/...', 'tokens' => 168760,
 *    'badge' => 'King' | 'Queen' | null]
 *
 * 'badge' is optional — only the top few rows tend to carry a title.
 * Falls back to mock rows so this view still renders on Day 1,
 * before $wo['top7_rankings'] is wired up.
 */

$topSeven = $wo['top7_rankings'] ?? [];

$currentUserId = !empty($wo['user']['user_id']) ? (int) $wo['user']['user_id'] : 0;

$podium = [];
$standard = [];
foreach ($topSeven as $row) {
    if ($row['rank'] <= 3) {
        $podium[(int) $row['rank']] = $row;
    } else {
        $standard[] = $row;
    }
}
// Display order: 2nd (left), 1st (center), 3rd (right)
$podiumDisplay = [$podium[2] ?? null, $podium[1] ?? null, $podium[3] ?? null];

function lb_initials(string $name): string
{
    return strtoupper(substr(trim($name), 0, 1)) ?: '?';
}
?>

<section class="hero-banner">
    <div class="hero-banner__content">
        <h1 class="hero-banner__title">Leaderboard</h1>
        <p class="hero-banner__subtitle">Top Kings and Queens of triBBBal</p>
        <div class="hero-banner__actions">
            <a href="javascript:void(0)" id="btn-view-full-rankings" class="btn-hero btn-hero--primary">View Full Rankings</a>
            <a href="javascript:void(0)" id="btn-view-my-rank" class="btn-hero btn-hero--ghost">My Rank</a>
        </div>
    </div>
    <i class="fa-solid fa-trophy hero-banner__trophy" aria-hidden="true"></i>
</section>

<!-- Decorative dots only — Dev 5 can wire these to whatever the banner cycles through -->
<div class="hero-banner__dots" aria-hidden="true">
    <span class="dot is-active"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
</div>

<div class="section-heading">
    <h2>Top Kings and Queens</h2>
</div>

<div class="quick-filters">
    <div class="filter-pills" id="time-filters-top7" role="tablist" aria-label="Leaderboard time range">
        <button type="button" class="pill active" data-filter="all-time">All Time</button>
        <button type="button" class="pill" data-filter="this-month">This Month</button>
        <button type="button" class="pill" data-filter="this-week">This Week</button>
        <button type="button" class="pill" data-filter="today">Today</button>
    </div>
    <div class="multiselect-wrapper" id="type-filter-wrapper-top7">
        <button type="button" class="multiselect-btn btn-type-filter">
            <span class="btn-text">All User Types</span>
            <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="multiselect-dropdown dropdown-type-filter">
            <label class="multiselect-option">
                <input type="checkbox" value="0" checked>
                <span class="check-mark"></span>
                Interns
            </label>
            <label class="multiselect-option">
                <input type="checkbox" value="2" checked>
                <span class="check-mark"></span>
                Mentors
            </label>
            <label class="multiselect-option">
                <input type="checkbox" value="1" checked>
                <span class="check-mark"></span>
                Admins
            </label>
        </div>
    </div>
</div>

<section class="podium" aria-label="Top 3 ranked users">
    <?php foreach ($podiumDisplay as $entry): ?>
        <?php if ($entry === null) { continue; } ?>
        <?php
            $rank = (int) $entry['rank'];
            $tier = $rank === 1 ? 'gold' : ($rank === 2 ? 'silver' : 'bronze');
            $isYou = $currentUserId && !empty($entry['user_id']) && (int) $entry['user_id'] === $currentUserId;
            $displayName = $entry['name'] ?? $entry['username'];
        ?>
        <div class="podium__place podium__place--<?php echo $tier; ?><?php echo $isYou ? ' podium__place--you' : ''; ?>" data-rank="<?php echo $rank; ?>">
            <?php if ($tier === 'gold'): ?>
                <i class="fa-solid fa-crown podium__crown" aria-hidden="true"></i>
            <?php endif; ?>
            <div class="podium__avatar">
                <?php if (!empty($entry['avatar'])): ?>
                    <img src="<?php echo clean($entry['avatar']); ?>" alt="">
                <?php else: ?>
                    <span><?php echo clean(lb_initials($displayName)); ?></span>
                <?php endif; ?>
            </div>
            <div class="podium__rank-number"><?php echo $rank; ?></div>
            <div class="podium__username"><?php echo clean($displayName); ?></div>
            <div class="podium__tokens"><?php echo number_format((int) $entry['tokens']); ?></div>
            <?php if (!empty($entry['status'])): ?>
                <span class="podium__badge"><?php echo clean(strtoupper($entry['status'])); ?></span>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
</section>

<section class="rank-cards" aria-label="Ranks 4 through 7">
    <?php foreach ($standard as $entry): ?>
        <?php
            $isYou = $currentUserId && !empty($entry['user_id']) && (int) $entry['user_id'] === $currentUserId;
            $displayName = $entry['name'] ?? $entry['username'];
        ?>
        <div class="rank-card<?php echo $isYou ? ' rank-card--you' : ''; ?>">
            <div class="rank-card__avatar">
                <?php if (!empty($entry['avatar'])): ?>
                    <img src="<?php echo clean($entry['avatar']); ?>" alt="">
                <?php else: ?>
                    <span><?php echo clean(lb_initials($displayName)); ?></span>
                <?php endif; ?>
            </div>
            <div class="rank-card__rank"><?php echo (int) $entry['rank']; ?></div>
            <div class="rank-card__username"><?php echo clean($displayName); ?></div>
            <div class="rank-card__tokens"><?php echo number_format((int) $entry['tokens']); ?></div>
        </div>
    <?php endforeach; ?>
</section>
