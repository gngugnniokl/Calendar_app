<div class="full-rankings-container">
    <!-- Header Section -->
    <header class="rankings-header">
        <button class="back-btn" id="btn-back-top7">
            <i class="fa-solid fa-arrow-left"></i> Back to Top 7
        </button>
        <h2>Full Rankings</h2>
        <div class="search-wrapper">
            <input type="text" id="search-members" class="search-bar" placeholder="Search members...">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
        </div>
    </header>

    <!-- Filters Section -->
    <section class="rankings-controls">
        <div class="filter-pills-container">
            <div class="filter-pills" id="time-filters-full">
                <button class="pill active" data-filter="all-time">All Time</button>
                <button class="pill" data-filter="this-month">This Month</button>
                <button class="pill" data-filter="this-week">This Week</button>
                <button class="pill" data-filter="today">Today</button>
            </div>
            <div class="multiselect-wrapper" id="type-filter-wrapper-full">
                <button type="button" class="multiselect-btn btn-type-filter">
                    <span class="btn-text">All User Types</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="multiselect-dropdown dropdown-type-filter">
                    <label class="multiselect-option">
                        <input type="checkbox" value="0" checked>
                        <span class="check-mark"></span>
                        Interns
                    </label>
                    <label class="multiselect-option">
                        <input type="checkbox" value="2" checked>
                        <span class="check-mark"></span>
                        Mentors
                    </label>
                    <label class="multiselect-option">
                        <input type="checkbox" value="1" checked>
                        <span class="check-mark"></span>
                        Admins
                    </label>
                </div>
            </div>
        </div>
        <div class="member-count">
            <span id="total-members-count">--</span> Members Ranked
        </div>
    </section>

    <!-- Data Table Section -->
    <div class="rankings-card">
    <div class="table-responsive">
        <table class="rankings-table">
            <thead>
                <tr>
                    <th>RANK</th>
                    <th>MEMBER</th>
                    <th>TOKENS</th>
                    <th>STATUS</th>
                    <th>JOINED</th>
                    <th>TREND</th>
                </tr>
            </thead>
            <tbody id="rankings-tbody">
                <!-- Data will be injected here by JS -->
            </tbody>
            <!-- "Your Rank" Highlight Row Injection Point -->
            <tbody id="user-highlight-container">
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <div class="pagination-wrapper">
        <button class="page-btn" id="page-prev" disabled><i class="fa-solid fa-chevron-left"></i> Previous</button>
        <div class="page-numbers" id="pagination-numbers">
        </div>
        <button class="page-btn" id="page-next" disabled>Next <i class="fa-solid fa-chevron-right"></i></button>
    </div>
    </div>
</div>