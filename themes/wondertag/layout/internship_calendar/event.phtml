<?php
// event.phtml
// Contains only event page markup.
// Expected variables: $event
?>
<?php if (!$event): ?>
    <?php
    $empty_message = "That event couldn't be found. It may have been deleted.";
    $empty_link = "index.php";
    $empty_link_text = "Back to Home";
    include __DIR__ . '/includes/empty-state.phtml';
    ?>
<?php else: ?>

<article class="event-detail <?php echo !empty($event['completed']) ? 'event-completed' : ''; ?>" data-event-id="<?php echo intval($event['id']); ?>">
    <header class="event-detail-header">
        <div class="event-detail-meta">
            <span class="week-tab"><?php echo clean($event['day']); ?> &middot; Week <?php echo intval($event['week']); ?></span>
            <time datetime="<?php echo clean($event['event_date']); ?>"><?php echo format_date($event['event_date'], 'l, F j, Y'); ?></time>
        </div>

        <div class="event-completion-toggle">
            <button type="button" class="btn <?php echo !empty($event['completed']) ? 'btn-ghost' : 'btn-primary'; ?> js-toggle-completion-btn" data-id="<?php echo intval($event['id']); ?>">
                <?php echo !empty($event['completed']) ? 'Completed ✓' : 'Mark Complete'; ?>
            </button>
        </div>
    </header>

    <main class="event-detail-main">
        <h1><?php echo clean($event['title']); ?></h1>

        <?php if (!empty($event['description'])): ?>
        <section class="event-block">
            <h2>Description</h2>
            <p><?php echo nl2br(clean($event['description'])); ?></p>
        </section>
        <?php endif; ?>

        <?php if (!empty($event['success_criteria'])): ?>
        <section class="event-block event-block-success">
            <h2>Success Criteria</h2>
            <p><?php echo nl2br(clean($event['success_criteria'])); ?></p>
        </section>
        <?php endif; ?>

        <?php if (!empty($event['traps'])): ?>
        <section class="event-block event-block-caution">
            <h2>Watch Outs / Traps</h2>
            <p><?php echo nl2br(clean($event['traps'])); ?></p>
        </section>
        <?php endif; ?>
    </main>

    <footer class="event-actions">
        <a href="#" class="btn btn-ghost js-open-edit-modal" data-id="<?php echo intval($event['id']); ?>" data-title="<?php echo clean($event['title']); ?>" data-event_date="<?php echo clean($event['event_date']); ?>" data-week="<?php echo intval($event['week']); ?>" data-day="<?php echo clean($event['day']); ?>" data-description="<?php echo clean($event['description'] ?? ''); ?>" data-success_criteria="<?php echo clean($event['success_criteria'] ?? ''); ?>" data-traps="<?php echo clean($event['traps'] ?? ''); ?>">Edit</a>
        <a href="#" class="btn btn-danger js-confirm-delete" data-id="<?php echo intval($event['id']); ?>">Delete</a>
        <a href="?link1=internship_calendar&week=<?php echo intval($event['week']); ?>" class="btn btn-ghost">&larr; Back to Week <?php echo intval($event['week']); ?></a>
    </footer>
</article>

<?php endif; ?>
