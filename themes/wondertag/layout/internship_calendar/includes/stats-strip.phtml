<?php
// stats-strip.phtml
// Extract dashboard statistics cards.
$stats = $stats ?? [];
?>
<div class="stat-grid">
    <?php foreach ($stats as $s): ?>
        <div class="stat-card" aria-label="<?php echo clean($s['label']); ?> statistics" data-stat="<?php echo clean($s['label']); ?>">
