<section class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark"></span>
            <h1 class="auth-title">Tribbbal Internship</h1>
            <p class="auth-subtitle">Enter your new password</p>
        </div>

        <div id="auth-error" class="auth-error" style="display:none;"></div>
        <div id="auth-success" class="auth-success" style="display:none;"></div>

        <form id="reset-form" class="auth-form">
            <input type="hidden" name="csrf_token" value="<?php echo $wo['csrf_token'] ?? ''; ?>">
            <input type="hidden" name="user_id" value="<?php echo intval($_GET['user_id'] ?? 0); ?>">

            <div class="form-group">
                <label for="reset-code">Reset Code</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-key input-icon"></i>
                    <input type="text" id="reset-code" name="code" class="form-control"
                           placeholder="6-digit code" required autocomplete="off">
                </div>
            </div>

            <div class="form-group">
                <label for="reset-password">New Password</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock input-icon"></i>
                    <input type="password" id="reset-password" name="password" class="form-control"
                           placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
                    <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="reset-confirm">Confirm New Password</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock input-icon"></i>
                    <input type="password" id="reset-confirm" name="confirm_password" class="form-control"
                           placeholder="Re-enter new password" required minlength="6" autocomplete="new-password">
                </div>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <span class="btn-text">Reset Password</span>
                <span class="btn-loader" style="display:none;">
                    <i class="fa fa-spinner fa-spin"></i>
                </span>
            </button>

            <div class="auth-links">
                <a href="?link1=welcome" class="auth-link"><i class="fa fa-arrow-left"></i> Back to Login</a>
            </div>
        </form>
    </div>
</section>

<script>
(function() {
    var form = document.getElementById('reset-form');
    var errorEl = document.getElementById('auth-error');
    var successEl = document.getElementById('auth-success');

    // Password toggle
    form.querySelectorAll('.password-toggle').forEach(function(toggle) {
        toggle.addEventListener('click', function() {
            var inp = toggle.parentElement.querySelector('input');
            var icon = toggle.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                inp.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        errorEl.style.display = 'none';
        successEl.style.display = 'none';

        var password = form.querySelector('#reset-password').value;
        var confirm = form.querySelector('#reset-confirm').value;

        if (password !== confirm) {
            errorEl.textContent = 'Passwords do not match.';
            errorEl.style.display = 'block';
            return;
        }

        if (password.length < 6) {
            errorEl.textContent = 'Password must be at least 6 characters.';
            errorEl.style.display = 'block';
            return;
        }

        var btn = form.querySelector('.auth-submit');
        var btnText = btn.querySelector('.btn-text');
        var btnLoader = btn.querySelector('.btn-loader');
        btn.disabled = true;
        btnText.style.display = 'none';
        btnLoader.style.display = 'inline-block';

        var formData = new FormData();
        formData.append('s', 'reset_password');
        formData.append('user_id', form.querySelector('[name="user_id"]').value);
        formData.append('code', form.querySelector('#reset-code').value.trim());
        formData.append('password', password);
        formData.append('confirm_password', confirm);
        formData.append('csrf_token', form.querySelector('[name="csrf_token"]').value);

        fetch('xhr/auth.php', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    successEl.textContent = data.message;
                    successEl.style.display = 'block';
                    form.style.display = 'none';
                    setTimeout(function() {
                        window.location.href = data.data.location || '?link1=welcome';
                    }, 2000);
                } else {
                    errorEl.textContent = data.message;
                    errorEl.style.display = 'block';
                }
            })
            .catch(function() {
                errorEl.textContent = 'Network error. Please try again.';
                errorEl.style.display = 'block';
            })
            .finally(function() {
                btn.disabled = false;
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
            });
    });
})();
</script>
