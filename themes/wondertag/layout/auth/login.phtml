<section class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark"></span>
            <h1 class="auth-title">Tribbbal Internship</h1>
            <p class="auth-subtitle">Sign in to your account</p>
        </div>

        <div id="auth-error" class="auth-error" style="display:none;"></div>

        <form id="login-form" class="auth-form" autocomplete="on">
            <input type="hidden" name="csrf_token" value="<?php echo $wo['csrf_token'] ?? ''; ?>">

            <div class="form-group">
                <label for="login-username">Username or Email</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-user input-icon"></i>
                    <input type="text" id="login-username" name="username" class="form-control"
                           placeholder="Enter your username or email" required autocomplete="username">
                </div>
            </div>

            <div class="form-group">
                <label for="login-password">Password</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-lock input-icon"></i>
                    <input type="password" id="login-password" name="password" class="form-control"
                           placeholder="Enter your password" required autocomplete="current-password">
                    <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <span class="btn-text">Log In</span>
                <span class="btn-loader" style="display:none;">
                    <i class="fa fa-spinner fa-spin"></i>
                </span>
            </button>

            <div class="auth-links">
                <a href="?link1=forgot_password" class="auth-link">Forgot password?</a>
                <span class="auth-link-divider">·</span>
                <a href="?link1=register" class="auth-link">Don't have an account? <strong>Register</strong></a>
            </div>
        </form>
    </div>
</section>

<script>
(function() {
    var form = document.getElementById('login-form');
    var errorEl = document.getElementById('auth-error');

    // Password toggle
    var toggle = form.querySelector('.password-toggle');
    if (toggle) {
        toggle.addEventListener('click', function() {
            var inp = form.querySelector('#login-password');
            var icon = toggle.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                inp.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        errorEl.style.display = 'none';

        var btn = form.querySelector('.auth-submit');
        var btnText = btn.querySelector('.btn-text');
        var btnLoader = btn.querySelector('.btn-loader');
        btn.disabled = true;
        btnText.style.display = 'none';
        btnLoader.style.display = 'inline-block';

        var formData = new FormData();
        formData.append('s', 'login');
        formData.append('username', form.querySelector('#login-username').value.trim());
        formData.append('password', form.querySelector('#login-password').value);
        formData.append('csrf_token', form.querySelector('[name="csrf_token"]').value);

        fetch('xhr/auth.php', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    window.location.href = data.data.location || '?link1=internship_calendar';
                } else {
                    errorEl.textContent = data.message;
                    errorEl.style.display = 'block';
                }
            })
            .catch(function() {
                errorEl.textContent = 'Network error. Please try again.';
                errorEl.style.display = 'block';
            })
            .finally(function() {
                btn.disabled = false;
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
            });
    });
})();
</script>
