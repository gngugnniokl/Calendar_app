<section class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark"></span>
            <h1 class="auth-title">Tribbbal Internship</h1>
            <p class="auth-subtitle">Reset your password</p>
        </div>

        <div id="auth-error" class="auth-error" style="display:none;"></div>
        <div id="auth-success" class="auth-success" style="display:none;"></div>

        <form id="forgot-form" class="auth-form">
            <input type="hidden" name="csrf_token" value="<?php echo $wo['csrf_token'] ?? ''; ?>">

            <div class="form-group">
                <label for="forgot-email">Email Address</label>
                <div class="input-icon-wrap">
                    <i class="fa fa-envelope input-icon"></i>
                    <input type="email" id="forgot-email" name="email" class="form-control"
                           placeholder="Enter your registered email" required autocomplete="email">
                </div>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <span class="btn-text">Send Reset Code</span>
                <span class="btn-loader" style="display:none;">
                    <i class="fa fa-spinner fa-spin"></i>
                </span>
            </button>

            <div class="auth-links">
                <a href="?link1=welcome" class="auth-link"><i class="fa fa-arrow-left"></i> Back to Login</a>
            </div>
        </form>
    </div>
</section>

<script>
(function() {
    var form = document.getElementById('forgot-form');
    var errorEl = document.getElementById('auth-error');
    var successEl = document.getElementById('auth-success');

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        errorEl.style.display = 'none';
        successEl.style.display = 'none';

        var btn = form.querySelector('.auth-submit');
        var btnText = btn.querySelector('.btn-text');
        var btnLoader = btn.querySelector('.btn-loader');
        btn.disabled = true;
        btnText.style.display = 'none';
        btnLoader.style.display = 'inline-block';

        var formData = new FormData();
        formData.append('s', 'forgot_password');
        formData.append('email', form.querySelector('#forgot-email').value.trim());
        formData.append('csrf_token', form.querySelector('[name="csrf_token"]').value);

        fetch('xhr/auth.php', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var msg = data.message;
                    if (data.data && data.data.code) {
                        msg += ' <br><strong>Dev Mode — Reset Code: ' + data.data.code + '</strong>';
                        if (data.data.user_id) {
                            msg += '<br><a href="?link1=reset_password&user_id=' + data.data.user_id + '" class="auth-link" style="margin-top:8px;display:inline-block;">Go to Reset Page →</a>';
                        }
                    }
                    successEl.innerHTML = msg;
                    successEl.style.display = 'block';
                } else {
                    errorEl.textContent = data.message;
                    errorEl.style.display = 'block';
                }
            })
            .catch(function() {
                errorEl.textContent = 'Network error. Please try again.';
                errorEl.style.display = 'block';
            })
            .finally(function() {
                btn.disabled = false;
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
            });
    });
})();
</script>
