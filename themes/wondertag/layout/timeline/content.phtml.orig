                                <span style="font-size: 11px; font-family: var(--font-mono); background: var(--paper); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--hairline);">WEEK <?php echo $event['week']; ?></span>
                                <span style="font-size: 11px; font-family: var(--font-mono); background: var(--paper); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--hairline);"><?php echo strtoupper($event['day']); ?></span>
