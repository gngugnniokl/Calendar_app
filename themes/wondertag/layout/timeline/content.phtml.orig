                        <div style="width:100%; height:100%; background: var(--pine-tint); color: var(--pine); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 40px; border-radius: 8px;">
                            <?php echo strtoupper(substr($name ?: $uname, 0, 2)); ?>
                        </div>
                    <?php endif; ?>
