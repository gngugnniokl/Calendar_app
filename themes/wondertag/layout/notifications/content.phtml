<script>
function nudgeBack(id, senderId, btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
    
    const formData = new FormData();
    formData.append('receiver_id', senderId);

    fetch('?link1=xhr_nudge', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 200) {
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Nudged!';
            btn.style.color = 'var(--pine)';
        } else {
            console.error('Nudge failed:', data.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-hand-point-left"></i> Try Again';
        }
    })
    .catch(err => {
        console.error('Error:', err);
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-hand-point-left"></i> Nudge Back';
    });
}
</script>